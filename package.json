{
  "name": "schau-werkstatt",
  "private": true,
  "type": "module",
  "description": "Schau- und Spiel-Werkstatt: druckbarer Guide (HTML/CSS → PDF) und kleine Web-App für ein Kind, das noch nicht liest",
  "scripts": {
    "build": "node build.mjs",
